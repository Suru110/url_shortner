{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "Serverless URL shortener built on AWS Lambda, API Gateway, and DynamoDB",
  "scripts": {
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "node scripts/test-api.js",
    "dev": "node server.js",
    "start": "node server.js",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:setup": "node scripts/create-table.js",
    "build": "sam build",
    "deploy": "sam build && sam deploy --guided",
    "deploy:dev": "sam build && sam deploy --config-env dev",
    "deploy:prod": "sam build && sam deploy --config-env prod",
    "local:api": "sam local start-api --env-vars env.local.json",
    "local:dynamodb": "docker run -p 8000:8000 amazon/dynamodb-local",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.637.0",
    "@aws-sdk/lib-dynamodb": "3.637.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "eslint": "8.57.0",
    "jest": "29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
